# OpsFlow Engine Configuration

# === Database (Postgres) ===
POSTGRES_USER=opsflow
POSTGRES_PASSWORD=opsflow_dev
POSTGRES_DB=opsflow
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Qdrant Vector Database ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === LLM (OpenAI-compatible API, optional) ===
# Without a key the system runs rule-based analysis only.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# === Langfuse Observability (optional) ===
# Optional: without keys, tracing degrades to no-ops and the stack runs with
# just API + Postgres + Qdrant. To run the observability services at all:
#   docker compose --profile observability up -d
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_SALT=changeme-min-32-chars
LANGFUSE_NEXTAUTH_SECRET=changeme-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# === Redis ===
REDIS_CONNECTION_URL=redis://redis:6379

# === ClickHouse ===
CLICKHOUSE_URL=http://clickhouse:8123

# === Environment ===
ENV=dev
