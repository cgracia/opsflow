# OpsFlow Engine Configuration

# === Database (Postgres) ===
POSTGRES_USER=opsflow
POSTGRES_PASSWORD=opsflow_dev
POSTGRES_DB=opsflow
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Qdrant Vector Database ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === LLM (OpenAI-compatible API) ===
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# === Langfuse Observability ===
# Langfuse keys — required for investigation tracing
# Get these from Langfuse UI at http://localhost:3000 after first boot
LANGFUSE_PUBLIC_KEY=pk-lz-replace-me
LANGFUSE_SECRET_KEY=sk-lz-replace-me
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_SALT=changeme-min-32-chars
LANGFUSE_NEXTAUTH_SECRET=changeme-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# === Redis ===
REDIS_CONNECTION_URL=redis://redis:6379

# === ClickHouse ===
CLICKHOUSE_URL=http://clickhouse:8123

# === Environment ===
ENV=dev
